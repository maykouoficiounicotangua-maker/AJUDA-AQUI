# ===== AJUDA AQUI — variáveis de ambiente =====
# Copie para .env.local (NUNCA commitar). No Vercel, configure em Production e Preview.

# --- Aplicação ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE servidor. Usada para envio de push e jobs. Jamais com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID (gere com: npm run vapid:generate) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Jobs (dispatch de push / expiração de pedidos) ---
# Segredo longo e aleatório; enviado como "Authorization: Bearer <valor>" por cron/webhook.
CRON_SECRET=
